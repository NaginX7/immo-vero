# ---------------------------------------------------------------------------
# Base de données — Neon (Postgres serverless)
# ---------------------------------------------------------------------------
# Utiliser la chaîne "pooled" (avec -pooler) pour l'application.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Sécurité — accès à l'espace de gestion
# ---------------------------------------------------------------------------
# Mot de passe unique pour accéder au CRM. OBLIGATOIRE en production :
# sans lui, l'accès aux données est bloqué (et non ouvert).
# La page publique /rdv reste accessible sans mot de passe.
APP_PASSWORD="choisir-un-mot-de-passe-long"

# Clé de signature du cookie de session (chaîne aléatoire longue).
# À générer avec :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="remplacer-par-une-chaine-aleatoire-de-64-caracteres"

# ---------------------------------------------------------------------------
# URL publique de l'application
# ---------------------------------------------------------------------------
# Sert à construire les liens envoyés par email (confirmation de rendez-vous).
# En production, indiquer le domaine réel — sinon les liens pointeront vers localhost.
APP_URL="https://admin.veronique-immobilier-saverne.fr"

# ---------------------------------------------------------------------------
# Resend — envoi d'emails
# ---------------------------------------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Expéditeur. Mode test : onboarding@resend.dev (envoi limité à votre propre
# adresse Resend). Après vérification du domaine sur Resend :
#   RESEND_FROM="Véronique Noureddine <contact@veronique-immobilier-saverne.fr>"
RESEND_FROM="L'Immobilière de Saverne <onboarding@resend.dev>"

# Adresse de réponse : quand un client répond à un email, sa réponse arrive ici.
# Permet d'expédier depuis le domaine vérifié tout en recevant les réponses dans
# la boîte habituelle (Resend authentifie des domaines, pas des adresses ; on ne
# peut donc pas expédier depuis @bskimmobilier.com, domaine du réseau BSK).
RESEND_REPLY_TO="v.noureddine@bskimmobilier.com"

# ---------------------------------------------------------------------------
# Rappels automatiques (48 h avant les rendez-vous)
# ---------------------------------------------------------------------------
# Secret protégeant la tâche planifiée /api/cron/rappels. Vercel le transmet
# automatiquement à la tâche définie dans vercel.json.
# À générer avec :  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="remplacer-par-une-chaine-aleatoire"
